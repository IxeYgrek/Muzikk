# Copy to .env and adjust to your host before running `docker compose up -d`.

# User and group that own the files Muzikk writes. Must match the owner of your
# music library, otherwise Jellyfin will not be able to read the imported files.
PUID=1000
PGID=1000
UMASK=002
TZ=Europe/Paris

# Host port exposed for the web interface.
MUZIKK_PORT=8383

# Where Muzikk keeps its database, encryption key, cache and logs.
MUZIKK_CONFIG=./config

# Host path holding the Jellyfin music library, and the path it is mounted on
# inside the Muzikk container. Use the very path Jellyfin reports for its own
# albums: Muzikk needs to resolve it to replace files when upgrading an album.
MUSIC_LIBRARY=/srv/media/music
MUSIC_LIBRARY_CONTAINER=/music

# Host path holding the downloads, and the path it is mounted on inside the
# container. It MUST be the path slskd and qBittorrent use themselves, because
# Muzikk reads the locations they report. Keep it on the same filesystem as the
# library so files are hardlinked instead of copied.
DOWNLOADS_ROOT=/srv/downloads
DOWNLOADS_CONTAINER=/downloads

# INFO, DEBUG, WARNING
MUZIKK_LOG_LEVEL=INFO
